{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Renesas RA8P1 AI \u5e94\u7528\u5f00\u53d1\u6307\u5357","text":"<p>\u672c\u6307\u5357\u9762\u5411\u4f7f\u7528 Renesas RA8P1 \u5f00\u53d1\u7aef\u4fa7 AI \u5e94\u7528\u7684\u5de5\u7a0b\u5e08\uff0c\u8986\u76d6\u6a21\u578b\u51c6\u5907\u3001\u5e73\u53f0\u914d\u7f6e\u3001Ethos-U55 NPU \u90e8\u7f72\u3001\u9a8c\u8bc1\u4f18\u5316\uff0c\u4ee5\u53ca\u4e0e HMI \u5e94\u7528\u7684\u96c6\u6210\u3002</p>"},{"location":"#_1","title":"\u4ece\u54ea\u91cc\u5f00\u59cb","text":"\u4f60\u7684\u76ee\u6807 \u5efa\u8bae\u8def\u5f84 \u7b2c\u4e00\u6b21\u4f7f\u7528 RA8P1 AI \u5e73\u53f0\u6982\u8ff0 -&gt; \u5f00\u53d1\u73af\u5883 -&gt; \u5feb\u901f\u5165\u95e8 -&gt; NPU \u63a8\u7406\u6d41\u7a0b \u5df2\u6709 ONNX \u6a21\u578b \u6a21\u578b\u8981\u6c42 -&gt; ONNX \u8f6c TFLite -&gt; INT8 \u91cf\u5316 -&gt; \u6a21\u578b\u96c6\u6210 \u6a21\u578b\u8fd0\u884c\u5931\u8d25 \u7b97\u5b50\u652f\u6301\u68c0\u67e5 -&gt; \u81ea\u5b9a\u4e49\u7b97\u5b50 -&gt; \u5e38\u89c1\u95ee\u9898"},{"location":"#_2","title":"\u5f00\u53d1\u4e3b\u7ebf","text":"<pre><code>ONNX \u6a21\u578b\n    |\n    +-- \u6a21\u578b\u7ed3\u6784\u68c0\u67e5\u3001TFLite \u8f6c\u6362\u3001INT8 \u91cf\u5316\u3001\u7cbe\u5ea6\u9a8c\u8bc1\n    |\n    v\nRA8P1 \u5e73\u53f0\u914d\u7f6e\n    |\n    +-- \u65f6\u949f\u914d\u7f6e\u3001\u5185\u5b58\u89c4\u5212\u3001\u6a21\u578b\u5b58\u50a8\u9009\u62e9\n    |\n    v\nTFLM + Ethos-U55 NPU \u90e8\u7f72\n    |\n    +-- \u6a21\u578b\u96c6\u6210\u3001\u7f16\u8bd1\u70e7\u5f55\u3001\u63a8\u7406\u9a8c\u8bc1\u3001\u6027\u80fd\u5206\u6790\n    |\n    v\n\u5e94\u7528\u96c6\u6210\n    |\n    +-- RUHMI \u4e0e RZ/V \u7cfb\u5217\u82af\u7247\u5185\u5bb9\u5165\u53e3\n</code></pre>"},{"location":"#_3","title":"\u90e8\u7f72\u524d\u786e\u8ba4","text":"<ul> <li>ONNX \u6a21\u578b\u5df2\u7ecf\u5728 PC \u4fa7\u5b8c\u6210\u57fa\u51c6\u63a8\u7406\u3002</li> <li>TFLite INT8 \u6a21\u578b\u7684\u7cbe\u5ea6\u6ee1\u8db3\u5e94\u7528\u8981\u6c42\u3002</li> <li>\u8f93\u5165\u524d\u5904\u7406\u3001\u8f93\u51fa\u540e\u5904\u7406\u4e0e\u8bad\u7ec3\u6d41\u7a0b\u4e00\u81f4\u3002</li> <li>\u5df2\u786e\u8ba4\u6a21\u578b\u7b97\u5b50\u652f\u6301\u60c5\u51b5\u3001Tensor Arena \u5927\u5c0f\u548c\u6a21\u578b\u5b58\u50a8\u4f4d\u7f6e\u3002</li> <li>NPU\u3001CPU\u3001\u603b\u7ebf\u548c\u5916\u90e8\u5b58\u50a8\u76f8\u5173\u65f6\u949f\u5df2\u7ecf\u5b8c\u6210\u89c4\u5212\u3002</li> </ul> <p>\u8bf7\u4ece\u5de6\u4fa7\u5bfc\u822a\u6309\u5f00\u53d1\u9636\u6bb5\u9605\u8bfb\uff0c\u6216\u4ece RA8P1 \u4ea7\u54c1\u9875\u9762 \u83b7\u53d6\u5e73\u53f0\u8d44\u6599\u3002</p>"},{"location":"01-overview/development-flow/","title":"\u5b8c\u6574\u5f00\u53d1\u6d41\u7a0b","text":""},{"location":"01-overview/development-flow/#_2","title":"\u5f00\u53d1\u4e3b\u7ebf","text":"<pre><code>\u51c6\u5907\u73af\u5883 -&gt; \u51c6\u5907 ONNX \u6a21\u578b -&gt; \u8f6c\u6362 TFLite -&gt; INT8 \u91cf\u5316\n     -&gt; \u68c0\u67e5\u7b97\u5b50 -&gt; \u914d\u7f6e\u65f6\u949f\u3001\u5185\u5b58\u548c\u5b58\u50a8\n     -&gt; \u96c6\u6210 TFLM \u4e0e\u6a21\u578b -&gt; NPU \u63a8\u7406 -&gt; \u9a8c\u8bc1\u4e0e\u4f18\u5316 -&gt; \u5e94\u7528\u96c6\u6210\n</code></pre>"},{"location":"01-overview/development-flow/#_3","title":"\u9636\u6bb5\u4ea7\u7269","text":"\u9636\u6bb5 \u4e3b\u8981\u4ea7\u7269 \u5b8c\u6210\u6807\u51c6 \u6a21\u578b\u51c6\u5907 ONNX\u3001TFLite\u3001INT8 TFLite PC \u4fa7\u7cbe\u5ea6\u7b26\u5408\u9884\u671f \u5e73\u53f0\u914d\u7f6e \u65f6\u949f\u3001\u5185\u5b58\u548c\u5b58\u50a8\u8bbe\u8ba1 \u8d44\u6e90\u89c4\u5212\u53ef\u5b9e\u65bd \u8bbe\u5907\u90e8\u7f72 \u53ef\u70e7\u5f55\u5de5\u7a0b\u548c\u6a21\u578b\u6570\u636e \u8bbe\u5907\u80fd\u7a33\u5b9a\u63a8\u7406 \u9a8c\u8bc1\u4f18\u5316 \u6d4b\u8bd5\u8bb0\u5f55 \u7cbe\u5ea6\u3001\u5ef6\u8fdf\u548c\u5185\u5b58\u6ee1\u8db3\u76ee\u6807 <p>\u6bcf\u4e2a\u9636\u6bb5\u51fa\u73b0\u95ee\u9898\u65f6\uff0c\u4f18\u5148\u56de\u5230\u4e0a\u4e00\u9636\u6bb5\u7684\u53ef\u9a8c\u8bc1\u4ea7\u7269\u3002\u8fd9\u6837\u53ef\u4ee5\u907f\u514d\u5c06\u6a21\u578b\u95ee\u9898\u8bef\u5224\u4e3a\u786c\u4ef6\u6216\u8fd0\u884c\u65f6\u95ee\u9898\u3002</p> <p>\u4e0b\u4e00\u6b65\uff1a\u5f00\u53d1\u524d\u7f6e\u6761\u4ef6\u3002</p>"},{"location":"01-overview/platform/","title":"\u5e73\u53f0\u4e0e\u8f6f\u4ef6\u67b6\u6784","text":""},{"location":"01-overview/platform/#_2","title":"\u672c\u7ae0\u76ee\u6807","text":"<p>\u7406\u89e3 RA8P1 \u7aef\u4fa7 AI \u5de5\u7a0b\u4e2d\u6a21\u578b\u3001\u8fd0\u884c\u65f6\u3001NPU \u4e0e\u5e94\u7528\u8f6f\u4ef6\u7684\u804c\u8d23\u8fb9\u754c\u3002</p>"},{"location":"01-overview/platform/#_3","title":"\u67b6\u6784\u5173\u7cfb","text":"<pre><code>\u5e94\u7528\u4efb\u52a1\n  |\n  +-- \u6570\u636e\u91c7\u96c6\u548c\u524d\u5904\u7406\n  +-- TensorFlow Lite Micro (TFLM)\n  |     |\n  |     +-- \u7b97\u5b50\u89e3\u6790\u3001Tensor Arena\u3001\u6a21\u578b\u8c03\u5ea6\n  |\n  +-- Ethos-U55 NPU\n  |     |\n  |     +-- \u652f\u6301\u7b97\u5b50\u7684\u786c\u4ef6\u52a0\u901f\n  |\n  +-- \u540e\u5904\u7406\u3001\u663e\u793a\u548c\u4e1a\u52a1\u63a7\u5236\n</code></pre> <ul> <li>\u6a21\u578b\u4fa7\uff1a\u5c06 ONNX \u6a21\u578b\u8f6c\u6362\u5e76\u91cf\u5316\u4e3a\u8bbe\u5907\u53ef\u7528\u7684 TFLite \u6a21\u578b\u3002</li> <li>\u8fd0\u884c\u65f6\uff1aTFLM \u8d1f\u8d23\u6a21\u578b\u52a0\u8f7d\u3001\u5f20\u91cf\u5185\u5b58\u548c\u7b97\u5b50\u8c03\u7528\u3002</li> <li>NPU\uff1aEthos-U55 \u4e3a\u53ef\u652f\u6301\u7684\u7b97\u5b50\u63d0\u4f9b\u52a0\u901f\uff1b\u4e0d\u652f\u6301\u7684\u7b97\u5b50\u53ef\u80fd\u7531 CPU \u6267\u884c\uff0c\u6216\u9700\u8981\u8c03\u6574\u6a21\u578b\u3002</li> <li>\u5e94\u7528\u4fa7\uff1a\u8d1f\u8d23\u8f93\u5165\u91c7\u96c6\u3001\u6570\u636e\u683c\u5f0f\u8f6c\u6362\u3001\u7ed3\u679c\u89e3\u91ca\u53ca\u4e0e HMI \u6216\u63a7\u5236\u903b\u8f91\u7684\u4ea4\u4e92\u3002</li> </ul>"},{"location":"01-overview/platform/#_4","title":"\u5173\u952e\u539f\u5219","text":"<p>\u6a21\u578b\u80fd\u6210\u529f\u8f6c\u6362\u4e0d\u7b49\u4e8e\u80fd\u5728\u76ee\u6807\u677f\u4e0a\u6b63\u786e\u3001\u5feb\u901f\u5730\u8fd0\u884c\u3002\u90e8\u7f72\u65f6\u5e94\u5206\u522b\u9a8c\u8bc1\u6a21\u578b\u7cbe\u5ea6\u3001\u7b97\u5b50\u652f\u6301\u3001\u5185\u5b58\u5360\u7528\u3001\u5b9e\u9645\u6267\u884c\u540e\u7aef\u548c\u63a8\u7406\u5ef6\u8fdf\u3002</p> <p>\u4e0b\u4e00\u6b65\uff1a\u5b8c\u6574\u5f00\u53d1\u6d41\u7a0b\u3002</p>"},{"location":"02-getting-started/prerequisites/","title":"\u5f00\u53d1\u524d\u7f6e\u6761\u4ef6","text":""},{"location":"02-getting-started/prerequisites/#_2","title":"\u786c\u4ef6","text":"<ul> <li>RA8P1 \u5f00\u53d1\u677f\u53ca\u5176\u5339\u914d\u7684\u8c03\u8bd5\u4e0b\u8f7d\u5668\u3002</li> <li>\u53ef\u9009\u7684\u4f20\u611f\u5668\u3001\u6444\u50cf\u5934\u3001\u663e\u793a\u5c4f\u6216\u5916\u90e8\u5b58\u50a8\u5668\u4ef6\u3002</li> <li>\u4e0e\u5b9e\u9645\u677f\u5361\u4e00\u81f4\u7684\u7535\u6e90\u3001\u542f\u52a8\u548c\u8fde\u63a5\u914d\u7f6e\u3002</li> </ul>"},{"location":"02-getting-started/prerequisites/#_3","title":"\u8f6f\u4ef6","text":"<ul> <li>\u5df2\u9a8c\u8bc1\u7248\u672c\u7684 FSP\u3001IDE\u3001\u7f16\u8bd1\u5668\u548c\u8c03\u8bd5\u5de5\u5177\u3002</li> <li>\u4e0e\u5de5\u7a0b\u5339\u914d\u7684 TFLM\u3001Ethos-U55 \u76f8\u5173\u7ec4\u4ef6\u548c\u6a21\u578b\u8f6c\u6362\u5de5\u5177\u3002</li> <li>\u7528\u4e8e\u6a21\u578b\u5904\u7406\u7684 Python \u73af\u5883\u53ca\u8f6c\u6362\u4f9d\u8d56\u3002</li> </ul> <p>\u8be6\u7ec6\u7248\u672c\u8bf7\u7ef4\u62a4\u5728\u7248\u672c\u517c\u5bb9\u8868\u3002\u4e0d\u8981\u4ec5\u4ee5\u201c\u6700\u65b0\u7248\u201d\u4f5c\u4e3a\u5de5\u7a0b\u4f9d\u8d56\u7ea6\u675f\u3002</p>"},{"location":"02-getting-started/prerequisites/#_4","title":"\u90e8\u7f72\u524d\u6e05\u5355","text":"<ul> <li>[ ] ONNX \u57fa\u7ebf\u6a21\u578b\u53ef\u4ee5\u5728 PC \u4e0a\u5b8c\u6210\u63a8\u7406\u3002</li> <li>[ ] \u8bad\u7ec3\u3001PC \u9a8c\u8bc1\u548c\u8bbe\u5907\u4fa7\u524d\u5904\u7406\u89c4\u5219\u4e00\u81f4\u3002</li> <li>[ ] \u5df2\u51c6\u5907\u53c2\u8003\u8f93\u5165\u548c\u9884\u671f\u8f93\u51fa\u3002</li> <li>[ ] \u5df2\u786e\u8ba4\u6a21\u578b\u8f93\u5165\u8f93\u51fa\u5f62\u72b6\u3001\u6570\u636e\u7c7b\u578b\u548c\u91cf\u5316\u53c2\u6570\u3002</li> <li>[ ] \u5df2\u9884\u4f30\u6a21\u578b\u3001Tensor Arena\u3001\u6808\u548c\u56fe\u5f62\u7f13\u51b2\u533a\u7684\u5185\u5b58\u5360\u7528\u3002</li> </ul> <p>\u4e0b\u4e00\u6b65\uff1a\u8fd0\u884c\u7b2c\u4e00\u4e2a\u793a\u4f8b\u3002</p>"},{"location":"02-getting-started/quick-start/","title":"\u8fd0\u884c\u7b2c\u4e00\u4e2a\u793a\u4f8b","text":""},{"location":"02-getting-started/quick-start/#_2","title":"\u76ee\u6807","text":"<p>\u4f7f\u7528\u5df2\u9a8c\u8bc1\u7684\u793a\u4f8b\u5de5\u7a0b\u5b8c\u6210\u4e00\u6b21\u4ece\u7f16\u8bd1\u3001\u70e7\u5f55\u5230\u4e32\u53e3\u6216\u8c03\u8bd5\u8f93\u51fa\u67e5\u770b\u7684\u7aef\u5230\u7aef\u63a8\u7406\u3002</p>"},{"location":"02-getting-started/quick-start/#_3","title":"\u64cd\u4f5c\u6b65\u9aa4","text":"<ol> <li>\u4f7f\u7528\u9879\u76ee\u6307\u5b9a\u7684 IDE \u548c FSP \u7248\u672c\u5bfc\u5165\u793a\u4f8b\u5de5\u7a0b\u3002</li> <li>\u68c0\u67e5\u76ee\u6807\u677f\u3001\u8c03\u8bd5\u5668\u548c\u6784\u5efa\u914d\u7f6e\u662f\u5426\u4e0e\u5de5\u7a0b\u4e00\u81f4\u3002</li> <li>\u7f16\u8bd1\u5de5\u7a0b\uff0c\u786e\u8ba4\u6a21\u578b\u6570\u636e\u3001TFLM \u7ec4\u4ef6\u548c\u7b97\u5b50\u6ce8\u518c\u5747\u5df2\u52a0\u5165\u6784\u5efa\u3002</li> <li>\u70e7\u5f55\u5e76\u590d\u4f4d\u5f00\u53d1\u677f\u3002</li> <li>\u8f93\u5165\u6837\u4f8b\u6570\u636e\uff0c\u8bb0\u5f55\u8f93\u51fa\u7c7b\u522b\u3001\u7f6e\u4fe1\u5ea6\u6216\u6570\u503c\u7ed3\u679c\u3002</li> </ol>"},{"location":"02-getting-started/quick-start/#_4","title":"\u9884\u671f\u7ed3\u679c","text":"<ul> <li>\u7f16\u8bd1\u65e0 Error\uff0c\u751f\u6210\u53ef\u70e7\u5f55\u955c\u50cf\u3002</li> <li>\u8bbe\u5907\u53ef\u4ee5\u542f\u52a8\uff0c\u4e14\u63a8\u7406\u8c03\u7528\u8fd4\u56de\u6210\u529f\u3002</li> <li>\u8f93\u51fa\u4e0e PC \u4fa7\u7684\u53c2\u8003\u8f93\u51fa\u5728\u5e94\u7528\u5b9a\u4e49\u7684\u5bb9\u5dee\u5185\u4e00\u81f4\u3002</li> </ul>"},{"location":"02-getting-started/quick-start/#_5","title":"\u5931\u8d25\u65f6\u4f18\u5148\u68c0\u67e5","text":"\u73b0\u8c61 \u9996\u5148\u68c0\u67e5 \u7f16\u8bd1\u6216\u94fe\u63a5\u5931\u8d25 \u5de5\u5177\u7248\u672c\u3001\u6a21\u578b\u6570\u7ec4\u3001\u7ec4\u4ef6\u548c\u7b97\u5b50\u6ce8\u518c \u542f\u52a8\u540e HardFault Tensor Arena\u3001\u6808\u3001\u6a21\u578b\u5730\u5740\u548c\u5916\u90e8\u5b58\u50a8\u521d\u59cb\u5316 \u8f93\u51fa\u660e\u663e\u9519\u8bef \u524d\u5904\u7406\u3001\u5f20\u91cf\u7c7b\u578b\u3001\u91cf\u5316\u53c2\u6570\u548c\u540e\u5904\u7406 <p>\u53c2\u89c1\uff1a\u5e38\u89c1\u95ee\u9898\u3002</p>"},{"location":"03-model-preparation/int8-quantization/","title":"INT8 \u91cf\u5316\u4e0e\u7cbe\u5ea6\u9a8c\u8bc1","text":""},{"location":"03-model-preparation/int8-quantization/#int8_1","title":"\u4e3a\u4ec0\u4e48\u4f7f\u7528 INT8","text":"<p>INT8 \u91cf\u5316\u901a\u5e38\u53ef\u964d\u4f4e\u6a21\u578b\u5b58\u50a8\u548c\u8fd0\u884c\u65f6\u5185\u5b58\u9700\u6c42\uff0c\u5e76\u4f7f\u6a21\u578b\u6ee1\u8db3 NPU \u90e8\u7f72\u7684\u7cbe\u5ea6\u683c\u5f0f\u8981\u6c42\u3002\u91cf\u5316\u5e26\u6765\u7684\u7cbe\u5ea6\u53d8\u5316\u5fc5\u987b\u7528\u4ee3\u8868\u6027\u6570\u636e\u9a8c\u8bc1\u3002</p>"},{"location":"03-model-preparation/int8-quantization/#_1","title":"\u64cd\u4f5c\u6b65\u9aa4","text":"<ol> <li>\u51c6\u5907\u8986\u76d6\u771f\u5b9e\u8f93\u5165\u8303\u56f4\u7684 representative dataset\u3002</li> <li>\u751f\u6210 INT8 TFLite \u6a21\u578b\uff0c\u5e76\u786e\u8ba4\u8f93\u5165\u8f93\u51fa\u662f\u5426\u540c\u6837\u91cf\u5316\u4e3a INT8\u3002</li> <li>\u8bb0\u5f55\u6bcf\u4e2a\u8f93\u5165\u8f93\u51fa\u5f20\u91cf\u7684 scale \u4e0e zero point\u3002</li> <li>\u4f7f\u7528\u540c\u4e00\u6279\u9a8c\u8bc1\u6837\u672c\u8fd0\u884c\u6d6e\u70b9\u57fa\u7ebf\u4e0e INT8 \u6a21\u578b\u3002</li> <li>\u5c06\u8bbe\u5907\u8f93\u51fa\u4e0e PC \u4fa7 INT8 \u53c2\u8003\u7ed3\u679c\u6bd4\u8f83\u3002</li> </ol>"},{"location":"03-model-preparation/int8-quantization/#_2","title":"\u5efa\u8bae\u6d4b\u8bd5\u8bb0\u5f55","text":"\u6a21\u578b \u5927\u5c0f \u7cbe\u5ea6\u6307\u6807 \u8f93\u5165\u7c7b\u578b \u8f93\u51fa\u7c7b\u578b \u539f\u59cb ONNX \u5f85\u586b\u5199 \u5f85\u586b\u5199 FP32 FP32 TFLite \u5f85\u586b\u5199 \u5f85\u586b\u5199 \u5f85\u586b\u5199 \u5f85\u586b\u5199 INT8 TFLite \u5f85\u586b\u5199 \u5f85\u586b\u5199 INT8 INT8"},{"location":"03-model-preparation/int8-quantization/#_3","title":"\u5e38\u89c1\u8bef\u533a","text":"<ul> <li>\u4f7f\u7528\u65e0\u6cd5\u4ee3\u8868\u5b9e\u9645\u6570\u636e\u5206\u5e03\u7684\u6821\u51c6\u96c6\u3002</li> <li>\u8bbe\u5907\u7aef\u4ecd\u6309 FP32 \u8303\u56f4\u5199\u5165 INT8 \u8f93\u5165\u5f20\u91cf\u3002</li> <li>\u5c06\u8f93\u51fa\u7684\u91cf\u5316\u6574\u6570\u76f4\u63a5\u4f5c\u4e3a\u4e1a\u52a1\u7ed3\u679c\uff0c\u672a\u6309\u91cf\u5316\u53c2\u6570\u89e3\u91ca\u3002</li> </ul>"},{"location":"03-model-preparation/model-requirements/","title":"\u6a21\u578b\u8981\u6c42","text":""},{"location":"03-model-preparation/model-requirements/#_2","title":"\u5728\u8f6c\u6362\u524d\u8bb0\u5f55\u6a21\u578b\u63a5\u53e3","text":"\u9879\u76ee \u9700\u8981\u786e\u8ba4\u7684\u5185\u5bb9 \u8f93\u5165 \u540d\u79f0\u3001\u5f62\u72b6\u3001\u5e03\u5c40\u3001\u6570\u636e\u7c7b\u578b\u3001\u6570\u503c\u8303\u56f4 \u8f93\u51fa \u540d\u79f0\u3001\u5f62\u72b6\u3001\u7c7b\u522b\u6216\u6570\u503c\u542b\u4e49 \u524d\u5904\u7406 \u5c3a\u5bf8\u8c03\u6574\u3001\u989c\u8272\u7a7a\u95f4\u3001\u5f52\u4e00\u5316\u3001\u91cf\u5316 \u540e\u5904\u7406 \u53cd\u91cf\u5316\u3001\u9608\u503c\u3001NMS\u3001\u6807\u7b7e\u6620\u5c04 \u7b97\u5b50 ONNX \u56fe\u4e2d\u4f7f\u7528\u7684\u7b97\u5b50\u548c\u5c5e\u6027"},{"location":"03-model-preparation/model-requirements/#_3","title":"\u8bbe\u8ba1\u7ea6\u675f","text":"<ul> <li>\u4f18\u5148\u4f7f\u7528\u56fa\u5b9a\u8f93\u5165\u7ef4\u5ea6\uff0c\u907f\u514d\u52a8\u6001\u7ef4\u5ea6\u76f4\u63a5\u8fdb\u5165\u5d4c\u5165\u5f0f\u90e8\u7f72\u6d41\u7a0b\u3002</li> <li>\u5c06\u524d\u5904\u7406\u548c\u540e\u5904\u7406\u89c6\u4e3a\u6a21\u578b\u63a5\u53e3\u7684\u4e00\u90e8\u5206\uff0c\u907f\u514d\u4ec5\u590d\u5236\u63a8\u7406\u8c03\u7528\u800c\u9057\u6f0f\u6570\u636e\u53d8\u6362\u3002</li> <li>\u8f6c\u6362\u524d\u68c0\u67e5\u7b97\u5b50\u652f\u6301\u60c5\u51b5\uff1b\u5fc5\u8981\u65f6\u5728\u8bad\u7ec3\u6216\u5bfc\u51fa\u9636\u6bb5\u66ff\u6362\u7ed3\u6784\u3002</li> <li>\u4e3a\u91cf\u5316\u51c6\u5907\u5177\u6709\u4ee3\u8868\u6027\u7684\u6821\u51c6\u6570\u636e\uff0c\u8986\u76d6\u771f\u5b9e\u8f93\u5165\u8303\u56f4\u3002</li> </ul> <p>\u4e0b\u4e00\u6b65\uff1aONNX \u8f6c TFLite\u3002</p>"},{"location":"03-model-preparation/onnx-to-tflite/","title":"ONNX \u8f6c TFLite","text":""},{"location":"03-model-preparation/onnx-to-tflite/#_1","title":"\u76ee\u6807","text":"<p>\u4ece\u7ecf\u9a8c\u8bc1\u7684 ONNX \u6a21\u578b\u751f\u6210\u53ef\u4f9b\u540e\u7eed INT8 \u91cf\u5316\u548c\u8bbe\u5907\u90e8\u7f72\u7684 TFLite \u6a21\u578b\u3002</p>"},{"location":"03-model-preparation/onnx-to-tflite/#_2","title":"\u63a8\u8350\u6d41\u7a0b","text":"<ol> <li>\u56fa\u5b9a\u8f93\u5165\u5f62\u72b6\uff0c\u5e76\u5728 PC \u4fa7\u4fdd\u5b58\u57fa\u51c6\u8f93\u5165\u548c\u8f93\u51fa\u3002</li> <li>\u4f7f\u7528\u9879\u76ee\u786e\u8ba4\u7684\u8f6c\u6362\u5de5\u5177\u94fe\u6267\u884c ONNX \u5230 TFLite \u8f6c\u6362\u3002</li> <li>\u68c0\u67e5\u8f6c\u6362\u65e5\u5fd7\u4e2d\u7684\u4e0d\u652f\u6301\u7b97\u5b50\u3001\u52a8\u6001\u5f62\u72b6\u548c\u6570\u636e\u7c7b\u578b\u53d8\u5316\u3002</li> <li>\u5728 PC \u4fa7\u5206\u522b\u8fd0\u884c ONNX \u4e0e\u751f\u6210\u7684 TFLite\uff0c\u6bd4\u8f83\u8f93\u51fa\u3002</li> <li>\u8bb0\u5f55\u6a21\u578b\u5927\u5c0f\u3001\u8f93\u5165\u8f93\u51fa\u7c7b\u578b\u3001\u5dee\u5f02\u6307\u6807\u548c\u5de5\u5177\u7248\u672c\u3002</li> </ol>"},{"location":"03-model-preparation/onnx-to-tflite/#_3","title":"\u9a8c\u8bc1\u91cd\u70b9","text":"<p>\u8f6c\u6362\u6210\u529f\u53ea\u4ee3\u8868\u6587\u4ef6\u751f\u6210\u6210\u529f\u3002\u5fc5\u987b\u81f3\u5c11\u9a8c\u8bc1\u6a21\u578b\u662f\u5426\u53ef\u52a0\u8f7d\u3001\u8f93\u5165\u8f93\u51fa\u5f20\u91cf\u662f\u5426\u7b26\u5408\u9884\u671f\uff0c\u4ee5\u53ca\u53c2\u8003\u6570\u636e\u7684\u8f93\u51fa\u662f\u5426\u53ef\u63a5\u53d7\u3002</p>"},{"location":"03-model-preparation/onnx-to-tflite/#_4","title":"\u4e0b\u4e00\u6b65","text":"<p>\u7ee7\u7eed\u8fdb\u884c INT8 \u91cf\u5316\u4e0e\u7cbe\u5ea6\u9a8c\u8bc1\u3002\u82e5\u9047\u5230\u7b97\u5b50\u95ee\u9898\uff0c\u8bf7\u5148\u9605\u8bfb\u7b97\u5b50\u652f\u6301\u68c0\u67e5\u3002</p>"},{"location":"04-platform-configuration/clock-and-memory/","title":"\u65f6\u949f\u4e0e\u5185\u5b58\u89c4\u5212","text":""},{"location":"04-platform-configuration/clock-and-memory/#_2","title":"\u76ee\u6807","text":"<p>\u5728\u96c6\u6210\u6a21\u578b\u524d\u786e\u5b9a\u5f71\u54cd\u63a8\u7406\u6027\u80fd\u548c\u7a33\u5b9a\u6027\u7684\u65f6\u949f\u3001\u5185\u5b58\u533a\u57df\u4e0e\u7f13\u51b2\u533a\u9884\u7b97\u3002</p>"},{"location":"04-platform-configuration/clock-and-memory/#_3","title":"\u65f6\u949f\u914d\u7f6e","text":"<p>\u63a8\u7406\u6027\u80fd\u4e0d\u4ec5\u53d7 NPU \u65f6\u949f\u5f71\u54cd\uff0c\u4e5f\u53d6\u51b3\u4e8e CPU\u3001\u603b\u7ebf\u3001\u5916\u90e8\u5b58\u50a8\u548c\u5185\u5b58\u63a5\u53e3\u3002\u5e94\u8bb0\u5f55\u5b9e\u9645\u5de5\u7a0b\u7684\u65f6\u949f\u914d\u7f6e\uff0c\u5e76\u5728\u6027\u80fd\u6d4b\u8bd5\u62a5\u544a\u4e2d\u4e00\u5e76\u7ed9\u51fa\u3002</p> <p>\u914d\u7f6e\u540e\u9700\u786e\u8ba4\uff1a</p> <ul> <li>NPU \u76f8\u5173\u65f6\u949f\u4e0e\u6a21\u5757\u521d\u59cb\u5316\u987a\u5e8f\u6b63\u786e\u3002</li> <li>CPU\u3001\u603b\u7ebf\u548c\u5916\u90e8\u5b58\u50a8\u63a5\u53e3\u80fd\u6ee1\u8db3\u6570\u636e\u642c\u8fd0\u9700\u6c42\u3002</li> <li>\u4f4e\u529f\u8017\u6216\u65f6\u949f\u5207\u6362\u7b56\u7565\u4e0d\u4f1a\u4e2d\u65ad\u6a21\u578b\u63a8\u7406\u3002</li> </ul>"},{"location":"04-platform-configuration/clock-and-memory/#_4","title":"\u5185\u5b58\u89c4\u5212","text":"\u5185\u5b58\u5bf9\u8c61 \u89c4\u5212\u8981\u70b9 \u6a21\u578b\u6570\u636e \u5927\u5c0f\u3001\u5bf9\u9f50\u3001\u53ef\u8bbf\u95ee\u533a\u57df\u548c\u52a0\u8f7d\u65b9\u5f0f Tensor Arena \u6309\u8fd0\u884c\u65f6\u5cf0\u503c\u9884\u7559\uff0c\u907f\u514d\u4e0e\u5176\u4ed6\u5927\u7f13\u51b2\u533a\u91cd\u53e0 \u6808\u548c\u5806 \u63a8\u7406\u4efb\u52a1\u4e0e\u9a71\u52a8\u521d\u59cb\u5316\u671f\u95f4\u7684\u5cf0\u503c\u7a7a\u95f4 \u8f93\u5165\u8f93\u51fa\u7f13\u51b2 \u56fe\u50cf\u3001\u4f20\u611f\u5668\u548c\u540e\u5904\u7406\u7684\u5e76\u53d1\u5360\u7528 \u56fe\u5f62\u7f13\u51b2 \u4e0e HMI \u5171\u7528\u5185\u5b58\u65f6\u7684\u603b\u91cf\u4e0e\u5e26\u5bbd <p>\u5177\u4f53\u9891\u7387\u3001\u5730\u5740\u548c\u5bb9\u91cf\u5e94\u4ee5\u677f\u5361\u3001FSP \u914d\u7f6e\u53ca\u5b98\u65b9\u8d44\u6599\u4e3a\u51c6\u3002</p>"},{"location":"04-platform-configuration/storage-selection/","title":"\u6a21\u578b\u5b58\u50a8\u4ecb\u8d28\u9009\u62e9","text":""},{"location":"04-platform-configuration/storage-selection/#_2","title":"\u9009\u62e9\u539f\u5219","text":"<p>\u6a21\u578b\u5b58\u653e\u4f4d\u7f6e\u540c\u65f6\u5f71\u54cd\u5bb9\u91cf\u3001\u542f\u52a8\u65f6\u95f4\u3001\u8bfb\u53d6\u5e26\u5bbd\u3001\u5e03\u677f\u590d\u6742\u5ea6\u548c\u7cfb\u7edf\u5185\u5b58\u9884\u7b97\u3002</p> <p>| \u5b58\u50a8\u4f4d\u7f6e | \u9002\u7528\u5185\u5bb9 | \u4f18\u70b9 | \u6ce8\u610f\u4e8b\u9879 | | --- | --- | --- | | \u7247\u5185 Flash | \u5c0f\u578b\u56fa\u5b9a\u6a21\u578b | \u96c6\u6210\u7b80\u5355\u3001\u542f\u52a8\u65b9\u4fbf | \u5bb9\u91cf\u6709\u9650 | | \u7247\u5185 RAM | Tensor Arena\u3001\u70ed\u70b9\u7f13\u51b2 | \u8bbf\u95ee\u5feb | \u7a7a\u95f4\u5b9d\u8d35 | | \u5916\u90e8 Flash | \u5927\u6a21\u578b\u3001\u8d44\u6e90\u6587\u4ef6 | \u5bb9\u91cf\u5927 | \u521d\u59cb\u5316\u3001\u8bfb\u53d6\u5e26\u5bbd\u548c\u6620\u5c04\u65b9\u5f0f | | \u5916\u90e8 RAM | \u5927\u578b Arena \u6216\u56fe\u50cf\u7f13\u51b2 | \u5bb9\u91cf\u5927 | \u63a5\u53e3\u65f6\u949f\u3001\u5bf9\u9f50\u548c\u7a33\u5b9a\u6027 |</p>"},{"location":"04-platform-configuration/storage-selection/#_3","title":"\u51b3\u7b56\u8def\u5f84","text":"<pre><code>\u6a21\u578b\u53ef\u653e\u5165\u7247\u5185 Flash\uff1f\n  \u662f -&gt; \u8bc4\u4f30\u7247\u5185\u5b58\u50a8\u548c\u542f\u52a8\u65f6\u95f4\n  \u5426 -&gt; \u8bc4\u4f30\u5916\u90e8 Flash \u6216\u52a0\u8f7d\u81f3\u5916\u90e8 RAM\n             -&gt; \u9a8c\u8bc1\u5e26\u5bbd\u3001\u521d\u59cb\u5316\u3001\u5730\u5740\u6620\u5c04\u548c\u529f\u8017\n</code></pre> <p>\u5728\u6700\u7ec8\u9009\u62e9\u524d\uff0c\u5e94\u5728\u76ee\u6807\u786c\u4ef6\u4e0a\u6d4b\u91cf\u5b9e\u9645\u52a0\u8f7d\u65f6\u95f4\u548c\u5355\u6b21\u63a8\u7406\u5ef6\u8fdf\u3002</p>"},{"location":"05-npu-deployment/inference-flow/","title":"NPU \u63a8\u7406\u6d41\u7a0b","text":""},{"location":"05-npu-deployment/inference-flow/#_1","title":"\u521d\u59cb\u5316\u9636\u6bb5","text":"<ol> <li>\u521d\u59cb\u5316\u677f\u7ea7\u9a71\u52a8\u3001\u65f6\u949f\u548c\u6a21\u578b\u5b58\u50a8\u63a5\u53e3\u3002</li> <li>\u53d6\u5f97\u6a21\u578b\u6570\u636e\uff0c\u521b\u5efa TFLM \u6a21\u578b\u4e0e\u89e3\u91ca\u5668\u3002</li> <li>\u6ce8\u518c\u6a21\u578b\u9700\u8981\u7684\u7b97\u5b50\uff0c\u5e76\u521d\u59cb\u5316 NPU \u76f8\u5173\u540e\u7aef\u3002</li> <li>\u5206\u914d Tensor Arena\uff0c\u83b7\u53d6\u8f93\u5165\u8f93\u51fa\u5f20\u91cf\u3002</li> <li>\u6821\u9a8c\u5f20\u91cf\u5f62\u72b6\u3001\u7c7b\u578b\u4e0e\u91cf\u5316\u53c2\u6570\u3002</li> </ol>"},{"location":"05-npu-deployment/inference-flow/#_2","title":"\u5355\u6b21\u63a8\u7406\u9636\u6bb5","text":"<pre><code>\u91c7\u96c6\u8f93\u5165 -&gt; \u524d\u5904\u7406 -&gt; \u5199\u5165\u8f93\u5165 Tensor -&gt; Invoke\n  -&gt; \u8bfb\u53d6\u8f93\u51fa Tensor -&gt; \u53cd\u91cf\u5316\u4e0e\u540e\u5904\u7406 -&gt; \u4e0a\u62a5\u7ed3\u679c\n</code></pre> <p>\u8f93\u5165\u5199\u5165\u524d\u5fc5\u987b\u4e0e\u6a21\u578b\u671f\u671b\u7684\u6570\u636e\u5e03\u5c40\u3001\u7c7b\u578b\u3001scale \u548c zero point \u4e00\u81f4\u3002<code>Invoke</code> \u6210\u529f\u4ec5\u8868\u660e\u8fd0\u884c\u65f6\u8c03\u7528\u5b8c\u6210\uff0c\u4ecd\u9700\u7528\u53c2\u8003\u6837\u672c\u9a8c\u8bc1\u7ed3\u679c\u3002</p>"},{"location":"05-npu-deployment/inference-flow/#_3","title":"\u9a8c\u8bc1\u9636\u6bb5","text":"\u7ef4\u5ea6 \u9a8c\u8bc1\u5185\u5bb9 \u529f\u80fd \u7a0b\u5e8f\u7a33\u5b9a\u8fd0\u884c\u5e76\u8f93\u51fa\u7ed3\u679c \u7cbe\u5ea6 \u4e0e PC \u4fa7 INT8 \u53c2\u8003\u7ed3\u679c\u63a5\u8fd1 \u540e\u7aef \u786e\u8ba4\u9884\u671f\u7b97\u5b50\u5b9e\u9645\u4f7f\u7528 NPU \u6216\u8bb0\u5f55 CPU fallback \u6027\u80fd \u5ef6\u8fdf\u3001\u541e\u5410\u548c\u5cf0\u503c\u5185\u5b58\u8fbe\u5230\u9879\u76ee\u76ee\u6807 <p>\u4e0b\u4e00\u6b65\uff1a\u6a21\u578b\u96c6\u6210\u3002</p>"},{"location":"05-npu-deployment/model-integration/","title":"\u6a21\u578b\u96c6\u6210","text":""},{"location":"05-npu-deployment/model-integration/#_2","title":"\u76ee\u6807","text":"<p>\u5c06\u5df2\u9a8c\u8bc1\u7684 INT8 TFLite \u6a21\u578b\u4f5c\u4e3a\u5de5\u7a0b\u8d44\u6e90\uff0c\u63a5\u5165 TFLM \u63a8\u7406\u4efb\u52a1\u3002</p>"},{"location":"05-npu-deployment/model-integration/#_3","title":"\u96c6\u6210\u6e05\u5355","text":"<ul> <li>\u6a21\u578b\u4e8c\u8fdb\u5236\u7684\u5b58\u50a8\u65b9\u5f0f\u4e0e\u94fe\u63a5\u533a\u57df\u3002</li> <li>\u6a21\u578b\u8d77\u59cb\u5730\u5740\u3001\u957f\u5ea6\u548c\u6240\u9700\u5bf9\u9f50\u3002</li> <li><code>MicroMutableOpResolver</code> \u6216\u9879\u76ee\u4f7f\u7528\u7684\u7b97\u5b50\u6ce8\u518c\u673a\u5236\u3002</li> <li>Tensor Arena \u7684\u5927\u5c0f\u3001\u4f4d\u7f6e\u53ca\u5176\u4e0e\u5e94\u7528\u7f13\u51b2\u533a\u7684\u5173\u7cfb\u3002</li> <li>\u8f93\u5165\u91c7\u96c6\u3001\u524d\u5904\u7406\u548c\u8f93\u51fa\u540e\u5904\u7406\u7684\u63a5\u53e3\u3002</li> <li>NPU \u521d\u59cb\u5316\u3001\u9519\u8bef\u5904\u7406\u548c\u6027\u80fd\u8ba1\u65f6\u63a5\u53e3\u3002</li> </ul>"},{"location":"05-npu-deployment/model-integration/#_4","title":"\u63a8\u8350\u9a8c\u8bc1\u987a\u5e8f","text":"<ol> <li>\u4ec5\u52a0\u8f7d\u6a21\u578b\uff0c\u786e\u8ba4 schema \u4e0e\u6a21\u578b\u7248\u672c\u517c\u5bb9\u3002</li> <li>\u5206\u914d\u5f20\u91cf\uff0c\u8bb0\u5f55\u6240\u9700 Arena \u5927\u5c0f\u3002</li> <li>\u5199\u5165\u56fa\u5b9a\u53c2\u8003\u8f93\u5165\uff0c\u6bd4\u8f83\u8f93\u51fa\u5f20\u91cf\u3002</li> <li>\u63a5\u5165\u771f\u5b9e\u8f93\u5165\u94fe\u8def\u3002</li> <li>\u8bb0\u5f55\u8fd0\u884c\u540e\u7aef\u3001\u8017\u65f6\u548c\u5185\u5b58\u3002</li> </ol> <p>\u4e0d\u8981\u53ea\u56e0\u6a21\u578b\u4f4d\u4e8e Flash \u5c31\u5047\u5b9a\u53ef\u76f4\u63a5\u8bbf\u95ee\uff1b\u5e94\u5728\u5b9e\u9645\u677f\u5361\u4e0a\u9a8c\u8bc1\u5b58\u50a8\u63a5\u53e3\u521d\u59cb\u5316\u3001\u53ef\u8bbf\u95ee\u6027\u548c\u8bfb\u53d6\u6027\u80fd\u3002</p>"},{"location":"05-npu-deployment/run-and-verify/","title":"\u7f16\u8bd1\u3001\u70e7\u5f55\u4e0e\u8fd0\u884c\u9a8c\u8bc1","text":""},{"location":"05-npu-deployment/run-and-verify/#_2","title":"\u7f16\u8bd1\u4e0e\u70e7\u5f55","text":"<p>\u4f7f\u7528\u7248\u672c\u517c\u5bb9\u8868\u4e2d\u8bb0\u5f55\u7684\u5de5\u5177\u94fe\u5b8c\u6210\u6784\u5efa\u3002\u70e7\u5f55\u524d\u786e\u8ba4\u76ee\u6807\u677f\u3001\u94fe\u63a5\u811a\u672c\u548c\u6a21\u578b\u5b58\u50a8\u533a\u57df\u4e0e\u5b9e\u9645\u786c\u4ef6\u4e00\u81f4\u3002</p>"},{"location":"05-npu-deployment/run-and-verify/#_3","title":"\u6700\u5c0f\u9a8c\u8bc1\u96c6","text":"<p>\u5bf9\u6bcf\u4e2a\u8f6f\u4ef6\u7248\u672c\uff0c\u81f3\u5c11\u4fdd\u7559\u4e00\u7ec4\u56fa\u5b9a\u8f93\u5165\u4e0e\u671f\u671b\u8f93\u51fa\uff0c\u5e76\u5728\u8bbe\u5907\u4e0a\u8bb0\u5f55\uff1a</p> \u9879\u76ee \u8bb0\u5f55\u503c \u6a21\u578b\u540d\u79f0\u548c\u7248\u672c \u5f85\u586b\u5199 \u8f93\u5165\u5c3a\u5bf8\u548c\u7c7b\u578b \u5f85\u586b\u5199 \u65f6\u949f\u914d\u7f6e \u5f85\u586b\u5199 \u6a21\u578b\u5b58\u50a8\u4f4d\u7f6e \u5f85\u586b\u5199 Tensor Arena \u5927\u5c0f \u5f85\u586b\u5199 \u5355\u6b21\u63a8\u7406\u5ef6\u8fdf \u5f85\u586b\u5199 \u5cf0\u503c\u5185\u5b58 \u5f85\u586b\u5199 NPU \u6267\u884c\u60c5\u51b5 \u5f85\u586b\u5199 \u7ed3\u679c\u4e0e\u57fa\u7ebf\u5dee\u5f02 \u5f85\u586b\u5199"},{"location":"05-npu-deployment/run-and-verify/#_4","title":"\u901a\u8fc7\u6807\u51c6","text":"<p>\u7a0b\u5e8f\u8fde\u7eed\u8fd0\u884c\u7a33\u5b9a\uff0c\u8f93\u51fa\u7b26\u5408\u9884\u8bbe\u5bb9\u5dee\uff0c\u4e14\u5185\u5b58\u3001\u5ef6\u8fdf\u548c\u540e\u7aef\u6267\u884c\u60c5\u51b5\u6ee1\u8db3\u5e94\u7528\u7ea6\u675f\u3002\u6027\u80fd\u5f02\u5e38\u65f6\u8bf7\u9605\u8bfb\u6027\u80fd\u4e0e\u5185\u5b58\u4f18\u5316\u3002</p>"},{"location":"06-optimization/performance/","title":"\u6027\u80fd\u4e0e\u5185\u5b58\u4f18\u5316","text":""},{"location":"06-optimization/performance/#_2","title":"\u6392\u67e5\u987a\u5e8f","text":"<pre><code>\u7ed3\u679c\u6b63\u786e\uff1f -&gt; \u7b97\u5b50\u662f\u5426\u7531 NPU \u6267\u884c\uff1f -&gt; \u65f6\u949f\u662f\u5426\u6b63\u786e\uff1f\n  -&gt; \u6a21\u578b\u548c\u7f13\u51b2\u533a\u4f4d\u4e8e\u4f55\u5904\uff1f -&gt; \u6570\u636e\u642c\u8fd0\u662f\u5426\u6210\u4e3a\u74f6\u9888\uff1f\n</code></pre>"},{"location":"06-optimization/performance/#_3","title":"\u4f18\u5316\u65b9\u5411","text":"\u73b0\u8c61 \u4f18\u5148\u68c0\u67e5 \u5e38\u89c1\u6539\u8fdb \u63a8\u7406\u5ef6\u8fdf\u9ad8 NPU \u540e\u7aef\u3001\u65f6\u949f\u3001CPU fallback \u8c03\u6574\u6a21\u578b\u7b97\u5b50\u3001\u65f6\u949f\u548c\u6570\u636e\u8def\u5f84 Arena \u4e0d\u8db3 \u5f20\u91cf\u5cf0\u503c\u3001\u5e76\u53d1\u7f13\u51b2 \u8c03\u6574\u5185\u5b58\u533a\u57df\u6216\u51cf\u5c11\u4e2d\u95f4\u5f20\u91cf \u542f\u52a8\u6162 \u6a21\u578b\u4f4d\u7f6e\u4e0e\u52a0\u8f7d\u65b9\u5f0f \u4f18\u5316\u5916\u90e8\u5b58\u50a8\u8bfb\u53d6\u4e0e\u521d\u59cb\u5316 HMI \u5361\u987f \u4efb\u52a1\u4f18\u5148\u7ea7\u3001\u5171\u4eab\u5e26\u5bbd \u5c06\u63a8\u7406\u4e0e\u754c\u9762\u5237\u65b0\u89e3\u8026 <p>\u6bcf\u6b21\u4f18\u5316\u53ea\u6539\u53d8\u4e00\u4e2a\u53ef\u6d4b\u91cf\u53d8\u91cf\uff0c\u5e76\u4fdd\u7559\u6a21\u578b\u7248\u672c\u3001\u65f6\u949f\u3001\u5b58\u50a8\u4f4d\u7f6e\u3001\u8f93\u5165\u6837\u672c\u548c\u6d4b\u91cf\u65b9\u6cd5\u3002\u8fd9\u6837\u6027\u80fd\u6570\u636e\u624d\u53ef\u6bd4\u8f83\u3002</p>"},{"location":"07-custom-operators/custom-operator/","title":"\u81ea\u5b9a\u4e49\u7b97\u5b50\u90e8\u7f72\u4e0e\u8c03\u8bd5","text":""},{"location":"07-custom-operators/custom-operator/#_2","title":"\u9002\u7528\u6761\u4ef6","text":"<p>\u4ec5\u5f53\u6a21\u578b\u7ed3\u6784\u4e0d\u80fd\u5408\u7406\u66ff\u6362\u3001\u4e14 CPU \u5b9e\u73b0\u7684\u6027\u80fd\u548c\u5185\u5b58\u6210\u672c\u53ef\u4ee5\u63a5\u53d7\u65f6\uff0c\u518d\u5f15\u5165\u81ea\u5b9a\u4e49\u7b97\u5b50\u3002</p>"},{"location":"07-custom-operators/custom-operator/#_3","title":"\u5b9e\u73b0\u8981\u70b9","text":"<ul> <li>\u5728 <code>Init</code> \u4e2d\u4fdd\u5b58\u957f\u671f\u9700\u8981\u7684\u4e0a\u4e0b\u6587\u3002</li> <li>\u5728 <code>Prepare</code> \u4e2d\u9a8c\u8bc1 Tensor \u7c7b\u578b\u3001\u7ef4\u5ea6\u3001\u91cf\u5316\u53c2\u6570\u5e76\u89c4\u5212\u4e34\u65f6\u5185\u5b58\u3002</li> <li>\u5728 <code>Eval</code> \u4e2d\u6267\u884c\u8ba1\u7b97\uff0c\u4e25\u683c\u5904\u7406\u8fb9\u754c\u3001\u5bf9\u9f50\u548c\u91cf\u5316\u3002</li> <li>\u5c06\u7b97\u5b50\u6ce8\u518c\u5230\u5de5\u7a0b\u5b9e\u9645\u4f7f\u7528\u7684 resolver\u3002</li> </ul>"},{"location":"07-custom-operators/custom-operator/#_4","title":"\u8c03\u8bd5\u6b65\u9aa4","text":"<ol> <li>\u5148\u5728 PC \u4fa7\u9488\u5bf9\u56fa\u5b9a\u8f93\u5165\u521b\u5efa\u5355\u5143\u6d4b\u8bd5\u3002</li> <li>\u5728\u8bbe\u5907\u4fa7\u6253\u5370\u8f93\u5165\u8f93\u51fa\u5f62\u72b6\u3001\u7c7b\u578b\u548c\u5173\u952e\u91cf\u5316\u53c2\u6570\u3002</li> <li>\u5148\u9a8c\u8bc1\u5355\u4e2a\u7b97\u5b50\u8f93\u51fa\uff0c\u518d\u9a8c\u8bc1\u6574\u5f20\u6a21\u578b\u3002</li> <li>\u9047\u5230 HardFault \u65f6\u68c0\u67e5 Arena\u3001\u6808\u3001\u5f20\u91cf\u7d22\u5f15\u548c\u6307\u9488\u8fb9\u754c\u3002</li> <li>\u8bb0\u5f55\u8be5\u7b97\u5b50\u662f CPU fallback \u8fd8\u662f\u53ef\u88ab NPU \u540e\u7aef\u5904\u7406\u3002</li> </ol> <p>\u6bcf\u4e2a\u81ea\u5b9a\u4e49\u7b97\u5b50\u5e94\u6709\u5df2\u77e5\u8f93\u5165\u3001\u9884\u671f\u8f93\u51fa\u548c\u8fb9\u754c\u6761\u4ef6\u6d4b\u8bd5\uff0c\u800c\u4e0d\u5e94\u53ea\u4f9d\u8d56\u6700\u7ec8\u5e94\u7528\u753b\u9762\u5224\u65ad\u6b63\u786e\u6027\u3002</p>"},{"location":"07-custom-operators/operator-support/","title":"\u7b97\u5b50\u652f\u6301\u68c0\u67e5","text":""},{"location":"07-custom-operators/operator-support/#_2","title":"\u4f55\u65f6\u68c0\u67e5","text":"<p>\u5728\u6a21\u578b\u8f6c\u6362\u540e\u3001\u8bbe\u5907\u96c6\u6210\u524d\u68c0\u67e5\u7b97\u5b50\u3002\u6a21\u578b\u521d\u59cb\u5316\u5931\u8d25\u3001\u65e0\u6cd5\u59d4\u6d3e\u7ed9 NPU \u6216\u6027\u80fd\u5f02\u5e38\u65f6\uff0c\u4e5f\u5e94\u91cd\u65b0\u786e\u8ba4\u8be5\u6e05\u5355\u3002</p>"},{"location":"07-custom-operators/operator-support/#_3","title":"\u51b3\u7b56\u6d41\u7a0b","text":"<pre><code>\u53d1\u73b0\u4e0d\u652f\u6301\u7b97\u5b50\n  -&gt; \u80fd\u5426\u7528\u53d7\u652f\u6301\u7b97\u5b50\u91cd\u5199\u6a21\u578b\uff1f\n       \u662f -&gt; \u4fee\u6539\u6a21\u578b\uff0c\u91cd\u65b0\u8f6c\u6362\u548c\u9a8c\u8bc1\n       \u5426 -&gt; \u8bc4\u4f30 TFLM \u81ea\u5b9a\u4e49\u7b97\u5b50\n                -&gt; \u786e\u8ba4 CPU \u8fd0\u884c\u6210\u672c\u548c NPU \u517c\u5bb9\u6027\n</code></pre>"},{"location":"07-custom-operators/operator-support/#_4","title":"\u5fc5\u987b\u533a\u5206","text":"<ul> <li>TFLM \u53ef\u8fd0\u884c\uff1a\u89e3\u91ca\u5668\u5b58\u5728\u8be5\u7b97\u5b50\u7684\u5b9e\u73b0\u3002</li> <li>NPU \u53ef\u52a0\u901f\uff1a\u8be5\u7b97\u5b50\u53ca\u5176\u53c2\u6570\u6ee1\u8db3 NPU \u540e\u7aef\u7ea6\u675f\u3002</li> </ul> <p>\u5b9e\u73b0\u81ea\u5b9a\u4e49 TFLM \u7b97\u5b50\u4e0d\u4f1a\u81ea\u52a8\u4f7f\u8be5\u7b97\u5b50\u5728 Ethos-U55 \u4e0a\u8fd0\u884c\u3002\u9700\u8981\u5355\u72ec\u786e\u8ba4\u5b9e\u9645\u6267\u884c\u540e\u7aef\u3002</p>"},{"location":"08-application/ruhmi/","title":"Renesas RUHMI","text":""},{"location":"08-application/ruhmi/#_1","title":"\u6982\u8ff0","text":"<p>\u6b64\u9875\u7528\u4e8e\u6c47\u96c6 RA8P1 AI \u63a8\u7406\u7ed3\u679c\u4e0e Renesas RUHMI \u5e94\u7528\u96c6\u6210\u7684\u8d44\u6599\u3002\u5178\u578b\u7528\u9014\u5305\u62ec\u5206\u7c7b\u72b6\u6001\u5c55\u793a\u3001\u5f02\u5e38\u544a\u8b66\u3001\u53c2\u6570\u53ef\u89c6\u5316\u548c\u8bbe\u5907\u63a7\u5236\u3002</p>"},{"location":"08-application/ruhmi/#ai-hmi","title":"AI \u4e0e HMI \u96c6\u6210\u6d41\u7a0b","text":"<pre><code>\u4f20\u611f\u5668\u6216\u56fe\u50cf\u8f93\u5165 -&gt; AI \u524d\u5904\u7406 -&gt; RA8P1 \u63a8\u7406\n  -&gt; \u540e\u5904\u7406\u4e0e\u4e1a\u52a1\u5224\u65ad -&gt; \u901a\u8fc7\u6d88\u606f\u6216\u5171\u4eab\u72b6\u6001\u66f4\u65b0 HMI\n</code></pre>"},{"location":"08-application/ruhmi/#_2","title":"\u96c6\u6210\u6ce8\u610f\u4e8b\u9879","text":"<ul> <li>\u4e0d\u5e94\u5728\u754c\u9762\u5237\u65b0\u8def\u5f84\u4e2d\u6267\u884c\u8017\u65f6\u7684\u540c\u6b65\u63a8\u7406\u3002</li> <li>\u63a8\u7406\u4efb\u52a1\u4e0e UI \u5237\u65b0\u4efb\u52a1\u5e94\u901a\u8fc7\u6d88\u606f\u3001\u4e8b\u4ef6\u6216\u53d7\u4fdd\u62a4\u7684\u6570\u636e\u7ed3\u6784\u4f20\u9012\u7ed3\u679c\u3002</li> <li>\u9700\u8981\u4e00\u8d77\u8bc4\u4f30 Tensor Arena\u3001\u8f93\u5165\u56fe\u50cf\u7f13\u51b2\u548c\u56fe\u5f62\u7f13\u51b2\u7684\u5185\u5b58\u4e0e\u5e26\u5bbd\u3002</li> <li>\u5728\u6301\u7eed\u63a8\u7406\u8d1f\u8f7d\u4e0b\u6d4b\u91cf\u754c\u9762\u5e27\u7387\u3001\u54cd\u5e94\u6027\u548c\u5f02\u5e38\u6062\u590d\u80fd\u529b\u3002</li> </ul>"},{"location":"08-application/ruhmi/#_3","title":"\u5b98\u65b9\u8d44\u6e90","text":"<p>\u586b\u5199 Renesas RUHMI \u5b98\u65b9\u7f51\u9875\u5730\u5740</p> <p>\u53d1\u5e03\u524d\u8bf7\u5c06\u4ee5\u4e0a\u94fe\u63a5\u66ff\u6362\u4e3a\u7ecf\u8fc7\u786e\u8ba4\u7684 Renesas RUHMI \u5b98\u65b9\u9875\u9762\u5730\u5740\u3002</p>"},{"location":"08-application/rz-v-placeholder/","title":"RZ/V \u7cfb\u5217\u82af\u7247","text":"<p>\u5185\u5bb9\u5f85\u8865\u5145\uff1a\u6b64\u4f4d\u7f6e\u9884\u7559\u7ed9 Renesas RZ/V \u7cfb\u5217\u82af\u7247\u7684 AI \u5f00\u53d1\u3001\u6a21\u578b\u90e8\u7f72\u3001\u8bc4\u4f30\u677f\u548c\u5e94\u7528\u96c6\u6210\u8d44\u6599\u3002</p>"},{"location":"08-application/rz-v-placeholder/#_1","title":"\u540e\u7eed\u5efa\u8bae\u5185\u5bb9","text":"<ul> <li>RZ/V \u7cfb\u5217\u4ea7\u54c1\u5b9a\u4f4d\u548c\u9002\u7528 AI \u573a\u666f\u3002</li> <li>\u4e0e RA8P1 \u5728\u7b97\u529b\u3001\u8f6f\u4ef6\u6808\u3001\u6a21\u578b\u683c\u5f0f\u548c\u90e8\u7f72\u6d41\u7a0b\u4e0a\u7684\u5dee\u5f02\u3002</li> <li>RZ/V \u8bc4\u4f30\u677f\u3001SDK\u3001\u5de5\u5177\u94fe\u4e0e\u5b98\u65b9\u8d44\u6e90\u94fe\u63a5\u3002</li> <li>\u6a21\u578b\u8fc1\u79fb\u3001\u6027\u80fd\u8bc4\u4f30\u548c HMI/\u89c6\u89c9\u5e94\u7528\u793a\u4f8b\u3002</li> </ul> <p>\u5728\u8865\u5145\u8be5\u7ae0\u8282\u524d\uff0c\u8bf7\u660e\u786e\u5177\u4f53\u82af\u7247\u578b\u53f7\u3001SDK \u7248\u672c\u3001\u76ee\u6807\u64cd\u4f5c\u7cfb\u7edf\u6216\u88f8\u673a\u73af\u5883\uff0c\u4ee5\u53ca\u5f15\u7528\u7684\u5b98\u65b9\u8d44\u6599\u6765\u6e90\u3002</p>"},{"location":"09-troubleshooting/common-errors/","title":"\u5e38\u89c1\u95ee\u9898","text":""},{"location":"09-troubleshooting/common-errors/#_2","title":"\u6545\u969c\u5b9a\u4f4d\u8def\u5f84","text":"<pre><code>\u65e0\u6cd5\u7f16\u8bd1 -&gt; \u5de5\u5177\u94fe\u3001\u7ec4\u4ef6\u3001\u6a21\u578b\u6570\u7ec4\u3001\u7b97\u5b50\u6ce8\u518c\n\u65e0\u6cd5\u542f\u52a8 -&gt; \u94fe\u63a5\u5730\u5740\u3001\u786c\u4ef6\u914d\u7f6e\u3001\u5b58\u50a8\u548c\u65f6\u949f\u521d\u59cb\u5316\nHardFault -&gt; Tensor Arena\u3001\u6808\u3001\u6307\u9488\u3001\u5916\u90e8\u5185\u5b58\u8fb9\u754c\n\u6a21\u578b\u521d\u59cb\u5316\u5931\u8d25 -&gt; \u6a21\u578b\u683c\u5f0f\u3001schema\u3001\u7b97\u5b50\u652f\u6301\n\u7ed3\u679c\u9519\u8bef -&gt; \u524d\u5904\u7406\u3001\u5e03\u5c40\u3001\u91cf\u5316\u3001\u540e\u5904\u7406\n\u6027\u80fd\u4e0d\u8db3 -&gt; NPU \u540e\u7aef\u3001\u65f6\u949f\u3001\u5b58\u50a8\u3001\u6570\u636e\u642c\u8fd0\n</code></pre>"},{"location":"09-troubleshooting/common-errors/#_3","title":"\u5e38\u89c1\u73b0\u8c61","text":"\u73b0\u8c61 \u53ef\u80fd\u539f\u56e0 \u6392\u67e5\u65b9\u6cd5 \u6a21\u578b\u52a0\u8f7d\u5931\u8d25 \u6a21\u578b\u635f\u574f\u6216 schema \u4e0d\u5339\u914d \u6821\u9a8c\u6a21\u578b\u957f\u5ea6\u3001\u7248\u672c\u548c PC \u52a0\u8f7d\u7ed3\u679c Arena \u5206\u914d\u5931\u8d25 \u5185\u5b58\u9884\u7b97\u4e0d\u8db3 \u8bb0\u5f55\u6240\u9700 Arena \u4e0e\u53ef\u7528\u533a\u57df\uff0c\u68c0\u67e5\u5e76\u53d1\u7f13\u51b2 \u8f93\u51fa\u5168\u76f8\u540c\u6216\u5f02\u5e38 \u8f93\u5165\u91cf\u5316\u6216\u5e03\u5c40\u9519\u8bef \u6253\u5370\u8f93\u5165\u5f20\u91cf\u9996\u5c3e\u6837\u672c\u3001scale \u548c zero point \u63a8\u7406\u6162 CPU fallback \u6216\u65f6\u949f\u4f4e \u8bb0\u5f55\u7b97\u5b50\u540e\u7aef\u3001\u9891\u7387\u3001\u5b58\u50a8\u4f4d\u7f6e\u548c\u8017\u65f6 HMI \u65e0\u54cd\u5e94 \u63a8\u7406\u5360\u7528\u4efb\u52a1\u6216\u5e26\u5bbd \u62c6\u5206\u4efb\u52a1\uff0c\u6d4b\u91cf\u5237\u65b0\u4e0e\u63a8\u7406\u65f6\u95f4 <p>\u6392\u67e5\u65f6\u5e94\u4e00\u6b21\u53ea\u6539\u52a8\u4e00\u4e2a\u53d8\u91cf\uff0c\u5e76\u4fdd\u5b58\u4e32\u53e3\u65e5\u5fd7\u3001\u6a21\u578b\u7248\u672c\u3001\u8f93\u5165\u6837\u672c\u548c\u5de5\u7a0b\u914d\u7f6e\u3002</p>"},{"location":"10-reference/source-documents/","title":"\u6e90\u6587\u6863\u4e0e\u7ef4\u62a4\u8bf4\u660e","text":"<p>\u672c\u7f51\u7ad9\u6309 RA8P1 AI \u5f00\u53d1\u6d41\u7a0b\u6574\u7406\uff0c\u5efa\u8bae\u5c06\u4e0b\u5217\u5df2\u6709\u8d44\u6599\u4f5c\u4e3a\u5bf9\u5e94\u7ae0\u8282\u7684\u5185\u5bb9\u6765\u6e90\uff0c\u5e76\u4fdd\u7559\u539f\u59cb\u6587\u4ef6\u4e0b\u8f7d\u5165\u53e3\uff1a</p> \u6e90\u8d44\u6599 \u5bf9\u5e94\u7ad9\u70b9\u7ae0\u8282 <code>NPU_inference_flow.md</code> NPU \u6a21\u578b\u90e8\u7f72 / NPU \u63a8\u7406\u6d41\u7a0b <code>ONNX\u8f6cTFLite\u4e0eINT8\u91cf\u5316\u6307\u5357_\u4e2d\u6587\u7248.md</code> \u6a21\u578b\u51c6\u5907 <code>RA8P1 + Ethos-U55 AI \u6a21\u578b\u90e8\u7f72\uff1a\u65f6\u949f\u914d\u7f6e\u4e0e\u5b58\u50a8\u4ecb\u8d28\u9009\u578b\u6307\u5357.pdf</code> \u5e73\u53f0\u914d\u7f6e <code>RA8P1 TFLM \u81ea\u5b9a\u4e49\u7b97\u5b50\u90e8\u7f72\u4e0e\u8c03\u8bd5\u6307\u5357.pdf</code> \u81ea\u5b9a\u4e49\u7b97\u5b50"},{"location":"10-reference/source-documents/#_2","title":"\u7ef4\u62a4\u539f\u5219","text":"<ul> <li>\u539f\u59cb\u8d44\u6599\u4e2d\u7684\u5177\u4f53\u547d\u4ee4\u3001\u622a\u56fe\u3001\u578b\u53f7\u53c2\u6570\u548c\u6d4b\u8bd5\u6570\u636e\u5e94\u7531\u8d44\u6599\u6240\u6709\u8005\u590d\u6838\u540e\u8865\u5165\u5bf9\u5e94\u9875\u9762\u3002</li> <li>\u6bcf\u9879\u53ef\u64cd\u4f5c\u6b65\u9aa4\u5747\u5e94\u5305\u542b\u524d\u7f6e\u6761\u4ef6\u3001\u9884\u671f\u7ed3\u679c\u548c\u5931\u8d25\u65f6\u7684\u6392\u67e5\u5165\u53e3\u3002</li> <li>\u4e00\u9879\u4e8b\u5b9e\u53ea\u7ef4\u62a4\u4e00\u4e2a\u6743\u5a01\u6765\u6e90\uff0c\u5176\u4f59\u7ae0\u8282\u4ee5\u94fe\u63a5\u5f15\u7528\uff0c\u907f\u514d\u7248\u672c\u6f02\u79fb\u3002</li> <li>\u53d1\u5e03\u524d\u5c06 RUHMI \u9875\u9762\u4e2d\u7684 URL \u5360\u4f4d\u7b26\u66ff\u6362\u4e3a\u5b98\u65b9\u94fe\u63a5\uff0c\u5e76\u8865\u5145 RZ/V \u7cfb\u5217\u8d44\u6599\u3002</li> </ul>"},{"location":"10-reference/version-matrix/","title":"\u7248\u672c\u517c\u5bb9\u8868","text":"<p>\u5d4c\u5165\u5f0f AI \u5de5\u5177\u94fe\u5bf9\u7248\u672c\u654f\u611f\u3002\u4ee5\u4e0b\u8868\u683c\u5e94\u8bb0\u5f55\u5df2\u7ecf\u5b9e\u9645\u9a8c\u8bc1\u8fc7\u7684\u7ec4\u5408\uff0c\u800c\u4e0d\u662f\u4ec5\u8bb0\u5f55\u53ef\u4e0b\u8f7d\u7684\u6700\u65b0\u7248\u672c\u3002</p> \u9879\u76ee \u5df2\u9a8c\u8bc1\u7248\u672c \u5907\u6ce8 RA8P1 \u677f\u5361\u548c\u786c\u4ef6\u7248\u672c \u5f85\u586b\u5199 FSP \u5f85\u586b\u5199 IDE \u5f85\u586b\u5199 \u7f16\u8bd1\u5668 \u5f85\u586b\u5199 TFLM \u5f85\u586b\u5199 Ethos-U55 \u76f8\u5173\u7ec4\u4ef6 \u5f85\u586b\u5199 \u6a21\u578b\u8f6c\u6362\u5de5\u5177 \u5f85\u586b\u5199 Python \u5f85\u586b\u5199 RUHMI \u76f8\u5173\u8f6f\u4ef6 \u5f85\u586b\u5199 <p>\u53d8\u66f4\u4efb\u4e00\u7248\u672c\u540e\uff0c\u8bf7\u81f3\u5c11\u91cd\u65b0\u6267\u884c\u56fa\u5b9a\u6837\u672c\u7684\u6a21\u578b\u52a0\u8f7d\u3001\u8bbe\u5907\u63a8\u7406\u548c\u6027\u80fd\u8bb0\u5f55\u3002</p>"}]}